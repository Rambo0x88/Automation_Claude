# DAM Automation v2 - Environment Configuration

# Application URL
BASE_URL=https://dam-sit.mqbc21.com

# Test Credentials
TEST_EMAIL=your_email@example.com
TEST_PASSWORD=your_password

# Browser Settings
BROWSER=chromium
HEADLESS=false
SLOW_MO=250

# Timeouts (milliseconds)
DEFAULT_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Video/Screenshot Settings
VIDEO_ENABLED=on-failure

# API Settings
COVALENT_API_KEY=
ENABLE_COINGECKO=false

# Extraction Settings
SKIP_PRICE_FETCHING=false
MAX_TOKENS_TO_PROCESS=0
PARALLEL_API_CALLS=3
API_TIMEOUT_SECONDS=5
